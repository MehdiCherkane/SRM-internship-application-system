# ============================================================
# ONEP Internship Portal — Environment Variables
# Copy this to .env or export before running the application
# Never commit the real .env file with secrets
# ============================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/internship_db
DB_USER=internship_app
DB_PASSWORD=<your-strong-password>

# Mail (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-gmail-address>
MAIL_PASSWORD=<your-gmail-app-password>

# Application
PORT=8080
APP_PUBLIC_BASE_URL=https://your-domain.com
APP_SECURITY_REQUIRE_HTTPS=true
APP_UPLOAD_DIR=./uploads

# Initial admin (seeded only when users table is empty)
APP_ADMIN_NAME=Admin SRM
APP_ADMIN_EMAIL=admin@srm.ma
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=<your-initial-admin-password>

# Session
SESSION_COOKIE_SECURE=true

# JPA (set to "validate" in production, "update" in dev)
JPA_DDL_AUTO=validate

# Thymeleaf (set to "true" in production)
THYMELEAF_CACHE=false
